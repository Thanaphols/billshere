# PostgreSQL (also used by the db service in docker-compose)
POSTGRES_USER=billshere
POSTGRES_PASSWORD=billshere_pass
POSTGRES_DB=billshere

# Prisma / app DB connection.
# - Host tooling (prisma migrate run from your machine) connects via localhost:5433.
# - Inside docker-compose the app service overrides this to use host "db".
DATABASE_URL=postgresql://billshere:billshere_pass@localhost:5433/billshere?schema=public

# Secret for signing JWT session cookies (change in production!)
JWT_SECRET=dev-secret-change-me-please-32chars-min

# Where uploaded transfer slips are stored.
UPLOAD_DIR=./uploads
